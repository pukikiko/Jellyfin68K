# Build output
/build/

# Basilisk II working state (system disk copy, app disk copy, prefs)
/.state/

# Local Mac ROM and system software: never commit these
/images/*
!/images/README.md

# The Mac's shared "Unix" volume contains runtime files (config, logs,
# downloaded MP3s, decoded AIFFs).  Keep only its README in git.
/shared/*
!/shared/README.txt

# Editor/OS noise
*~
.DS_Store
__pycache__/
